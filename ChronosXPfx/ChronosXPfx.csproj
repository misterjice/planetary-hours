<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ChronosXPfx</RootNamespace>
    <AssemblyName>ChronosXPfx</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- WithCulture=false: names like Default.Sun.gif must not be read as culture "Sun". -->
    <EmbeddedResource Include="*.ico;*.gif" WithCulture="false" />
  </ItemGroup>
</Project>
